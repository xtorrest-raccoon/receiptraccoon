{
  "expo": {
    "name": "ReceiptRaccoon",
    "slug": "receiptraccoon-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "receiptraccoon",
    "icon": "./assets/images/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.receiptraccoon.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "ReceiptRaccoon needs camera access to photograph and scan receipts.",
        "NSPhotoLibraryUsageDescription": "ReceiptRaccoon needs photo library access to import receipt photos."
      }
    },
    "android": {
      "package": "com.receiptraccoon.mobile",
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#5EAE7C"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "ReceiptRaccoon needs camera access to photograph and scan receipts."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ReceiptRaccoon needs photo library access to import receipt photos."
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
