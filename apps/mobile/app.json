{
  "expo": {
    "name": "Claimeo Pro",
    "slug": "claimeo-pro-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "claimeopro",
    "icon": "./assets/images/claimeo-pro-icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.claimeo.pro",
      "infoPlist": {
        "NSCameraUsageDescription": "Claimeo Pro needs camera access to photograph and scan receipts.",
        "NSPhotoLibraryUsageDescription": "Claimeo Pro needs photo library access to import receipt photos."
      }
    },
    "android": {
      "package": "com.claimeo.pro",
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/claimeo-pro-icon.png",
        "backgroundColor": "#0B4A50"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Claimeo Pro needs camera access to photograph and scan receipts."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Claimeo Pro needs photo library access to import receipt photos."
        }
      ],
      "expo-localization",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
