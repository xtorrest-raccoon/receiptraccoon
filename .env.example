# Copy to .env.local and fill in. NEVER commit the filled-in version.

# ── OpenAI (extraction) ─────────────────────────────────────
# Server-side only. Must never reach the Expo or Next.js client bundle.
OPENAI_API_KEY=sk-proj-...

# Workhorse model, and the model we escalate to on low confidence.
EXTRACTION_PROVIDER=openai
EXTRACTION_MODEL=gpt-5.6-luna
EXTRACTION_ESCALATION_MODEL=gpt-5.6-terra
EXTRACTION_CONFIDENCE_THRESHOLD=0.85

# ── Supabase ────────────────────────────────────────────────
# URL + anon key are safe in clients (RLS enforces access).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Same project, Expo's own public-env prefix — Next.js and Expo each inline
# only their own *_PUBLIC_* vars at build time, so this is duplicated rather
# than shared.
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Service role bypasses RLS. Server-side only, never in a client bundle.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── FX rates ────────────────────────────────────────────────
# ECB daily reference feed — free, no key required.
FX_FEED_URL=https://www.ecb.europa.eu/stats/eurofxref/eurofxref-daily.xml

# ── Google Maps (mileage: automatic distance from addresses) ──
# Server-side only, same rule as OPENAI_API_KEY above. Create in Google Cloud
# Console with the Distance Matrix API enabled.
GOOGLE_MAPS_API_KEY=AIza...
